@model List<AttributeDef>
@{ ViewData["Title"] = "Thuộc tính"; }
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Danh mục thuộc tính dùng chung</h6>
        <table class="table table-hover align-middle">
            <thead><tr><th>Mã</th><th>Tên</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td class="fw-semibold">@a.Code</td><td>@a.Name</td>
                    <td>@if (a.Active) { <span class="badge bg-success">Dùng</span> } else { <span class="badge bg-secondary">Ẩn</span> }</td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="3" class="text-center text-muted py-4">Chưa có thuộc tính.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm thuộc tính</h6>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-2"><label class="form-label small text-muted">Tên *</label><input name="name" class="form-control" required /></div>
            <div class="mb-3"><label class="form-label small text-muted">Mã</label><input name="code" class="form-control" placeholder="tự sinh" /></div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
        </form>
    </div></div></div>
</div>
