@model CurrencyEx
@{ ViewData["Title"] = Model.Id > 0 ? "Sửa tỷ giá ngoại tệ" : "Thêm tỷ giá ngoại tệ"; }
<div class="row g-3">
    <div class="col-lg-6"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">@ViewData["Title"]</h6>
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="mb-2">
                <label class="form-label small text-muted">Mã ngoại tệ *</label>
                <input name="code" value="@Model.Code" class="form-control" required @(Model.Id > 0 ? "readonly" : "") />
            </div>
            <div class="mb-2"><label class="form-label small text-muted">Tên ngoại tệ *</label><input name="name" value="@Model.Name" class="form-control" required /></div>
            <div class="mb-2"><label class="form-label small text-muted">Đồng tiền gốc</label><input name="baseCurrencyCode" value="@Model.BaseCurrencyCode" class="form-control" placeholder="vd: VND" /></div>
            <div class="row g-2 mb-2">
                <div class="col-6"><label class="form-label small text-muted">Tỷ giá mua</label><input name="buyRate" type="number" step="0.000001" value="@Model.BuyRate" class="form-control" /></div>
                <div class="col-6"><label class="form-label small text-muted">Tỷ giá bán</label><input name="sellRate" type="number" step="0.000001" value="@Model.SellRate" class="form-control" /></div>
            </div>
            <div class="mb-2"><label class="form-label small text-muted">Tỷ giá liên ngân hàng</label><input name="interEx" type="number" step="0.000001" value="@Model.InterEx" class="form-control" /></div>
            <div class="mb-2"><label class="form-label small text-muted">Ghi chú</label><input name="remark" value="@Model.Remark" class="form-control" /></div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="active" value="true" id="active" @(Model.Active ? "checked" : "") />
                <label class="form-check-label" for="active">Đang dùng</label>
            </div>
            <button class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu</button>
            <a class="btn btn-outline-secondary" href="/CurrencyEx">Hủy</a>
        </form>
    </div></div></div>
</div>