@model List<ProductGroup>
@{ ViewData["Title"] = "Nhóm sản phẩm"; }
<div class="row g-3">
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm nhóm</h6>
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-2"><input name="name" class="form-control" placeholder="Tên nhóm *" required /></div>
            <div class="mb-3"><input name="code" class="form-control" placeholder="Mã (tự sinh nếu trống)" /></div>
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Tạo nhóm</button>
        </form>
    </div></div></div>
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <table class="table table-hover align-middle">
            <thead><tr><th>Mã</th><th>Tên nhóm</th></tr></thead>
            <tbody>
            @foreach (var g in Model) { <tr><td class="fw-semibold">@g.Code</td><td>@g.Name</td></tr> }
            @if (Model.Count == 0) { <tr><td colspan="2" class="text-center text-muted py-4">Chưa có nhóm.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
</div>
