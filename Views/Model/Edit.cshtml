@model Model
@{ ViewData["Title"] = Model.Id > 0 ? "Sửa model" : "Thêm model"; }
<div class="row g-3">
    <div class="col-lg-6"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">@ViewData["Title"]</h6>
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="mb-2">
                <label class="form-label small text-muted">Mã model *</label>
                <input name="code" value="@Model.Code" class="form-control" required @(Model.Id > 0 ? "readonly" : "") />
            </div>
            <div class="mb-2"><label class="form-label small text-muted">Tên model *</label><input name="name" value="@Model.Name" class="form-control" required /></div>
            <div class="mb-2">
                <label class="form-label small text-muted">Nhãn hiệu *</label>
                <select name="brandCode" class="form-select" required>
                    <option value="">— chọn nhãn hiệu —</option>
                    @foreach (var b in (List<Brand>)ViewBag.Brands)
                    {
                        <option value="@b.Code" selected="@(b.Code == Model.BrandCode)">@b.Code — @b.Name</option>
                    }
                </select>
            </div>
            <div class="mb-2"><label class="form-label small text-muted">Mã model theo tổ chức</label><input name="orgModelCode" value="@Model.OrgModelCode" class="form-control" /></div>
            <div class="mb-2"><label class="form-label small text-muted">Mã model chung network</label><input name="networkModelCode" value="@Model.NetworkModelCode" class="form-control" /></div>
            <div class="mb-2"><label class="form-label small text-muted">Ghi chú</label><input name="remark" value="@Model.Remark" class="form-control" /></div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="active" value="true" id="active" @(Model.Active ? "checked" : "") />
                <label class="form-check-label" for="active">Đang dùng</label>
            </div>
            <button class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu</button>
            <a class="btn btn-outline-secondary" href="/Model">Hủy</a>
        </form>
    </div></div></div>
</div>