@model Product
@{
    ViewData["Title"] = Model.Id > 0 ? $"Sản phẩm {Model.Code}" : "Thêm sản phẩm";
    var groups = (List<ProductGroup>)ViewBag.Groups;
}
<form asp-action="Save" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="row g-3">
        <div class="col-lg-8"><div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3">Thông tin sản phẩm</h6>
            <div class="row g-3">
                <div class="col-md-4"><label class="form-label small text-muted">Mã SKU</label><input name="code" value="@Model.Code" class="form-control" placeholder="tự sinh" /></div>
                <div class="col-md-8"><label class="form-label small text-muted">Tên *</label><input name="name" value="@Model.Name" class="form-control" required /></div>
                <div class="col-md-5"><label class="form-label small text-muted">Nhóm</label>
                    <select name="groupId" class="form-select"><option value="">—</option>
                        @foreach (var g in groups) { <option value="@g.Id" selected="@(Model.GroupId==g.Id)">@g.Name</option> }
                    </select></div>
                <div class="col-md-3"><label class="form-label small text-muted">ĐVT</label><input name="uom" value="@(Model.Uom)" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Barcode</label><input name="barcode" value="@Model.Barcode" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Giá vốn</label><input name="costPrice" type="number" step="1000" value="@Model.CostPrice" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Giá bán</label><input name="salePrice" type="number" step="1000" value="@Model.SalePrice" class="form-control" /></div>
                <div class="col-md-4"><label class="form-label small text-muted">Trạng thái</label>
                    <select name="status" class="form-select">
                        <option value="0" selected="@(Model.Status==ProductStatus.Active)">Đang bán</option>
                        <option value="1" selected="@(Model.Status==ProductStatus.Inactive)">Ngừng</option>
                    </select></div>
                <div class="col-12"><label class="form-label small text-muted">Mô tả</label><textarea name="description" class="form-control" rows="2">@Model.Description</textarea></div>
            </div>
        </div></div></div>

        <div class="col-lg-4">
            <div class="card mb-3"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2"><h6 class="fw-bold mb-0">Thuộc tính động</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addAttr()"><i class="bi bi-plus"></i></button></div>
                <div id="attrs">
                    @foreach (var a in Model.Attributes)
                    { <div class="d-flex gap-1 mb-1"><input name="attrName" value="@a.Name" class="form-control form-control-sm" placeholder="Tên" /><input name="attrValue" value="@a.Value" class="form-control form-control-sm" placeholder="Giá trị" /></div> }
                </div>
            </div></div>
            <div class="card"><div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2"><h6 class="fw-bold mb-0">Định mức BOM</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addBom()"><i class="bi bi-plus"></i></button></div>
                <div id="boms">
                    @foreach (var x in Model.Bom)
                    { <div class="d-flex gap-1 mb-1"><input name="bomName" value="@x.ComponentName" class="form-control form-control-sm" placeholder="Thành phần" /><input name="bomCode" value="@x.ComponentCode" class="form-control form-control-sm" style="max-width:80px" placeholder="Mã" /><input name="bomQty" value="@x.Quantity" type="number" step="0.001" class="form-control form-control-sm" style="max-width:70px" /><input name="bomUom" value="@x.Uom" class="form-control form-control-sm" style="max-width:60px" /></div> }
                </div>
            </div></div>
        </div>
    </div>
    <div class="mt-3"><button class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu</button> <a href="/Product" class="btn btn-outline-secondary">Về danh sách</a></div>
</form>
@section Scripts {
<script>
function addAttr(){document.getElementById('attrs').insertAdjacentHTML('beforeend','<div class="d-flex gap-1 mb-1"><input name="attrName" class="form-control form-control-sm" placeholder="Tên"/><input name="attrValue" class="form-control form-control-sm" placeholder="Giá trị"/></div>');}
function addBom(){document.getElementById('boms').insertAdjacentHTML('beforeend','<div class="d-flex gap-1 mb-1"><input name="bomName" class="form-control form-control-sm" placeholder="Thành phần"/><input name="bomCode" class="form-control form-control-sm" style="max-width:80px" placeholder="Mã"/><input name="bomQty" type="number" step="0.001" value="1" class="form-control form-control-sm" style="max-width:70px"/><input name="bomUom" value="cái" class="form-control form-control-sm" style="max-width:60px"/></div>');}
</script>
}
