@model List<ProductImage>
@{
    ViewData["Title"] = "Ảnh hàng hóa";
    var products = ViewBag.Products as List<Product> ?? new();
    string? cur = ViewBag.ProductCode as string;
}
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">Ảnh của hàng hóa</h6>
            <form class="d-flex" method="get">
                <select name="productCode" class="form-select form-select-sm me-2" onchange="this.form.submit()">
                    <option value="">— Tất cả hàng hóa —</option>
                    @foreach (var p in products)
                    {
                        <option value="@p.Code" selected="@(p.Code == cur)">@p.Code — @p.Name</option>
                    }
                </select>
                <noscript><button class="btn btn-sm btn-outline-primary">Lọc</button></noscript>
            </form>
        </div>
        <table class="table table-hover align-middle">
            <thead><tr><th>Hàng hóa</th><th>Thứ tự</th><th>Ảnh</th><th>Mô tả</th><th>Ảnh chính</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td class="fw-semibold">@i.ProductCode</td>
                    <td>@i.Idx</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <img src="@i.ImagePath" alt="@i.ImageName" style="width:40px;height:40px;object-fit:cover;border-radius:6px;background:#eee" onerror="this.style.visibility='hidden'" />
                            <span class="text-muted small">@i.ImageName</span>
                        </div>
                    </td>
                    <td class="text-muted small">@i.ImageDesc</td>
                    <td>@if (i.FlagPrimaryImage) { <span class="badge bg-primary">Chính</span> }</td>
                    <td>@if (i.Active) { <span class="badge bg-success">Dùng</span> } else { <span class="badge bg-secondary">Ẩn</span> }</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/ProductImage/Edit/@i.Id"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Xóa ảnh này?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@i.Id" />
                            <input type="hidden" name="productCode" value="@cur" />
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa có ảnh hàng hóa.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm ảnh hàng hóa</h6>
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="0" />
            <div class="mb-2">
                <label class="form-label small text-muted">Hàng hóa *</label>
                <select name="productCode" class="form-select" required>
                    <option value="">— Chọn hàng hóa —</option>
                    @foreach (var p in products) { <option value="@p.Code">@p.Code — @p.Name</option> }
                </select>
            </div>
            <div class="mb-2"><label class="form-label small text-muted">Thứ tự</label><input name="idx" type="number" value="0" class="form-control" /></div>
            <div class="mb-2"><label class="form-label small text-muted">Đường dẫn ảnh *</label><input name="imagePath" class="form-control" required placeholder="vd: /images/ao-001.jpg" /></div>
            <div class="mb-2"><label class="form-label small text-muted">Tên ảnh</label><input name="imageName" class="form-control" /></div>
            <div class="mb-2"><label class="form-label small text-muted">Mô tả</label><input name="imageDesc" class="form-control" /></div>
            <div class="mb-2"><label class="form-label small text-muted">Network ID</label><input name="networkId" class="form-control" /></div>
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" name="flagPrimaryImage" value="true" id="primary" />
                <label class="form-check-label" for="primary">Ảnh chính</label>
            </div>
            <input type="hidden" name="active" value="true" />
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
        </form>
    </div></div></div>
</div>
