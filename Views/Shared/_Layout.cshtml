@{
    string Nav(string c) => (ViewContext.RouteData.Values["controller"]?.ToString() == c) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MiniPIM</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root { --accent:#4f46e5; --accent2:#4338ca; --sidebar:#171630; }
        body { font-size:14px; background:#f4f4fb; font-family:"Be Vietnam Pro",sans-serif; -webkit-font-smoothing:antialiased; }
        .sidebar { width:230px; min-height:100vh; background:var(--sidebar); flex-shrink:0; }
        .sidebar .brand { color:#fff; font-weight:800; font-size:18px; padding:20px 18px 12px; display:flex; align-items:center; gap:9px; }
        .sidebar .brand span { color:#a5b4fc; }
        .sidebar .nav-link { color:#a5a3c4; padding:9px 18px; display:flex; align-items:center; gap:10px; font-size:14px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color:#fff; background:rgba(79,70,229,.3); border-left:3px solid var(--accent); }
        .sidebar .nav-section { font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#514f74; padding:14px 18px 4px; }
        .topbar { background:#fff; border-bottom:1px solid #e6e6f0; padding:11px 24px; }
        .content-area { padding:24px; }
        .card { border:none; box-shadow:0 1px 4px rgba(2,6,40,.07); border-radius:13px; }
        .btn-primary { background:var(--accent); border-color:var(--accent); } .btn-primary:hover { background:var(--accent2); border-color:var(--accent2); }
        .btn-outline-primary { color:var(--accent); border-color:var(--accent); } .btn-outline-primary:hover { background:var(--accent); color:#fff; }
        a { color:var(--accent2); }
        table th { font-size:11.5px; text-transform:uppercase; letter-spacing:.4px; color:#6b7280; border-bottom:2px solid #e5e7eb; }
        .stat-num { font-size:26px; font-weight:800; }
    </style>
</head>
<body>
<div class="d-flex">
    <nav class="sidebar d-flex flex-column">
        <div class="brand"><i class="bi bi-boxes"></i> Mini<span>PIM</span></div>
        <div class="mt-1">
            <div class="nav-section">Tổng quan</div>
            <a class="nav-link @(Nav("Home"))" href="/"><i class="bi bi-speedometer2"></i> Bảng điều khiển</a>
            <div class="nav-section">Danh mục</div>
            <a class="nav-link @(Nav("Product"))" href="/Product"><i class="bi bi-box-seam"></i> Sản phẩm</a>
            <a class="nav-link @(Nav("Group"))" href="/Group"><i class="bi bi-diagram-3"></i> Nhóm sản phẩm</a>
            <a class="nav-link @(Nav("Attribute"))" href="/Attribute"><i class="bi bi-tags"></i> Thuộc tính</a>
            <a class="nav-link @(Nav("Unit"))" href="/Unit"><i class="bi bi-rulers"></i> Đơn vị tính</a>
            <a class="nav-link @(Nav("VatRate"))" href="/VatRate"><i class="bi bi-percent"></i> Thuế suất GTGT</a>
            <a class="nav-link @(Nav("Spec"))" href="/Spec"><i class="bi bi-upc-scan"></i> Quy cách</a>
            <a class="nav-link @(Nav("SpecPrice"))" href="/SpecPrice"><i class="bi bi-cash-coin"></i> Bảng giá</a>
            <div class="nav-section">Hệ thống</div>
            <a class="nav-link @(Nav("Org"))" href="/Org"><i class="bi bi-building"></i> Tổ chức</a>
        </div>
        <div class="mt-auto p-3" style="color:#514f74;font-size:11px">Master data · catalog API · demo</div>
    </nav>
    <div class="main-content flex-fill" style="overflow-x:hidden">
        <div class="topbar d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-bold">@ViewData["Title"]</h6>
            <a href="/Org" class="text-muted small text-decoration-none"><i class="bi bi-building me-1"></i>@(Context.Request.Cookies["org_name"] ?? "Demo PIM")</a>
        </div>
        <div class="content-area">
            @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @RenderBody()
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
