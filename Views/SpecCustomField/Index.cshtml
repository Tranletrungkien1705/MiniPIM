@model List<SpecCustomField>
@{ ViewData["Title"] = "Trường tùy chỉnh quy cách"; }
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">Danh mục trường tùy chỉnh quy cách</h6>
            <form class="d-flex" method="get">
                <input name="q" value="@ViewBag.Q" class="form-control form-control-sm me-2" placeholder="Tìm mã / tên..." />
                <button class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
            </form>
        </div>
        <table class="table table-hover align-middle">
            <thead><tr><th>Mã trường</th><th>Tên trường tùy chỉnh</th><th>Kiểu dữ liệu</th><th>Network</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var f in Model)
            {
                <tr>
                    <td class="fw-semibold">@f.Code</td>
                    <td>@f.Name</td>
                    <td class="text-muted small">@f.DBPhysicalType</td>
                    <td class="text-muted small">@f.NetworkId</td>
                    <td>@if (f.Active) { <span class="badge bg-success">Dùng</span> } else { <span class="badge bg-secondary">Ẩn</span> }</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/SpecCustomField/Edit/@f.Id"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Xóa trường tùy chỉnh này?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@f.Id" />
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có trường tùy chỉnh.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm trường tùy chỉnh</h6>
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="0" />
            <div class="mb-2"><label class="form-label small text-muted">Mã trường *</label><input name="code" class="form-control" required placeholder="vd: SCF001" /></div>
            <div class="mb-2"><label class="form-label small text-muted">Tên trường tùy chỉnh *</label><input name="name" class="form-control" required placeholder="vd: Chất liệu vải" /></div>
            <div class="mb-2"><label class="form-label small text-muted">Kiểu dữ liệu</label><input name="dbPhysicalType" class="form-control" placeholder="nvarchar(400)" /></div>
            <div class="mb-2"><label class="form-label small text-muted">Network ID</label><input name="networkId" class="form-control" /></div>
            <div class="mb-3"><label class="form-label small text-muted">Ghi chú</label><input name="remark" class="form-control" /></div>
            <input type="hidden" name="active" value="true" />
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
        </form>
    </div></div></div>
</div>