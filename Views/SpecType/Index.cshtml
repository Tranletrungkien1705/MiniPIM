@model List<SpecType>
@{ ViewData["Title"] = "Loại quy cách"; int? kind = ViewBag.Kind; }
<div class="row g-3">
    <div class="col-lg-8"><div class="card"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">Danh mục loại quy cách</h6>
            <form class="d-flex" method="get">
                <select name="kind" class="form-select form-select-sm me-2" onchange="this.form.submit()">
                    <option value="" selected="@(kind == null)">Tất cả loại</option>
                    <option value="1" selected="@(kind == 1)">Loại 1 (SpecType1)</option>
                    <option value="2" selected="@(kind == 2)">Loại 2 (SpecType2)</option>
                </select>
                <input name="q" value="@ViewBag.Q" class="form-control form-control-sm me-2" placeholder="Tìm mã / tên..." />
                <button class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
            </form>
        </div>
        <table class="table table-hover align-middle">
            <thead><tr><th>Loại</th><th>Mã loại</th><th>Tên loại quy cách</th><th>Network</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@if (t.Kind == 1) { <span class="badge bg-primary">Loại 1</span> } else { <span class="badge bg-info text-dark">Loại 2</span> }</td>
                    <td class="fw-semibold">@t.Code</td>
                    <td>@t.Name</td>
                    <td class="text-muted small">@t.NetworkId</td>
                    <td>@if (t.Active) { <span class="badge bg-success">Dùng</span> } else { <span class="badge bg-secondary">Ẩn</span> }</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/SpecType/Edit/@t.Id"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Xóa loại quy cách này?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@t.Id" />
                            <input type="hidden" name="kind" value="@kind" />
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có loại quy cách.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
    <div class="col-lg-4"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thêm loại quy cách</h6>
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="0" />
            <div class="mb-2">
                <label class="form-label small text-muted">Loại *</label>
                <select name="kind" class="form-select">
                    <option value="1" selected="@(kind != 2)">Loại 1 (SpecType1)</option>
                    <option value="2" selected="@(kind == 2)">Loại 2 (SpecType2)</option>
                </select>
            </div>
            <div class="mb-2"><label class="form-label small text-muted">Mã loại *</label><input name="code" class="form-control" required placeholder="vd: SIZE" /></div>
            <div class="mb-2"><label class="form-label small text-muted">Tên loại quy cách *</label><input name="name" class="form-control" required placeholder="vd: Kích cỡ" /></div>
            <div class="mb-2"><label class="form-label small text-muted">Network ID</label><input name="networkId" class="form-control" /></div>
            <div class="mb-3"><label class="form-label small text-muted">Ghi chú</label><input name="remark" class="form-control" /></div>
            <input type="hidden" name="active" value="true" />
            <button class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Thêm</button>
        </form>
    </div></div></div>
</div>
