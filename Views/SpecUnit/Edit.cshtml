@model SpecUnit
@{
    ViewData["Title"] = Model.Id > 0 ? "Sửa đơn vị tính theo quy cách" : "Thêm đơn vị tính theo quy cách";
    var specs = ViewBag.Specs as List<Spec>;
    var units = ViewBag.Units as List<Unit>;
}
<div class="row g-3">
    <div class="col-lg-6"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">@ViewData["Title"]</h6>
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="mb-2">
                <label class="form-label small text-muted">Quy cách *</label>
                @if (Model.Id > 0)
                {
                    <input class="form-control" value="@Model.SpecCode" disabled />
                    <input type="hidden" name="specCode" value="@Model.SpecCode" />
                }
                else
                {
                    <select name="specCode" class="form-select" required>
                        <option value="">— Chọn quy cách —</option>
                        @foreach (var s in specs ?? new()) { <option value="@s.Code" selected="@(s.Code == Model.SpecCode)">@s.Code — @s.Name</option> }
                    </select>
                }
            </div>
            <div class="mb-2">
                <label class="form-label small text-muted">Đơn vị tính *</label>
                @if (Model.Id > 0)
                {
                    <input class="form-control" value="@Model.UnitCode" disabled />
                    <input type="hidden" name="unitCode" value="@Model.UnitCode" />
                }
                else
                {
                    <select name="unitCode" class="form-select" required>
                        <option value="">— Chọn ĐVT —</option>
                        @foreach (var un in units ?? new()) { <option value="@un.CodeUser" selected="@(un.CodeUser == Model.UnitCode)">@un.CodeUser — @un.Name</option> }
                    </select>
                }
            </div>
            <div class="mb-2"><label class="form-label small text-muted">ĐVT chuẩn</label>
                <select name="standardUnitCode" class="form-select">
                    <option value="">— (không) —</option>
                    @foreach (var un in units ?? new()) { <option value="@un.CodeUser" selected="@(un.CodeUser == Model.StandardUnitCode)">@un.CodeUser — @un.Name</option> }
                </select>
            </div>
            <div class="mb-2"><label class="form-label small text-muted">Mô tả</label><input name="description" value="@Model.Description" class="form-control" /></div>
            <div class="row g-2 mb-2">
                <div class="col-6"><label class="form-label small text-muted">Hệ số quy đổi</label><input name="qty" type="number" step="0.001" value="@Model.Qty" class="form-control" /></div>
                <div class="col-6"><label class="form-label small text-muted">Khối lượng</label><input name="weight" type="number" step="0.001" value="@Model.Weight" class="form-control" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-4"><label class="form-label small text-muted">Dài</label><input name="length" type="number" step="0.001" value="@Model.Length" class="form-control" /></div>
                <div class="col-4"><label class="form-label small text-muted">Rộng</label><input name="width" type="number" step="0.001" value="@Model.Width" class="form-control" /></div>
                <div class="col-4"><label class="form-label small text-muted">Cao</label><input name="height" type="number" step="0.001" value="@Model.Height" class="form-control" /></div>
            </div>
            <div class="mb-2"><label class="form-label small text-muted">Thể tích</label><input name="volume" type="number" step="0.001" value="@Model.Volume" class="form-control" /></div>
            <div class="mb-2"><label class="form-label small text-muted">Ghi chú</label><input name="remark" value="@Model.Remark" class="form-control" /></div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="active" value="true" id="active" @(Model.Active ? "checked" : "") />
                <label class="form-check-label" for="active">Đang dùng</label>
            </div>
            <button class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu</button>
            <a class="btn btn-outline-secondary" href="/SpecUnit">Hủy</a>
        </form>
    </div></div></div>
</div>