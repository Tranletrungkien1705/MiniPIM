@model Unit
@{ ViewData["Title"] = Model.Id > 0 ? "Sửa đơn vị tính" : "Thêm đơn vị tính"; }
<div class="row g-3">
    <div class="col-lg-6"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">@ViewData["Title"]</h6>
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="code" value="@Model.Code" />
            <div class="mb-2">
                <label class="form-label small text-muted">Mã hệ thống</label>
                <input class="form-control" value="@(string.IsNullOrEmpty(Model.Code) ? "(tự sinh)" : Model.Code)" disabled />
            </div>
            <div class="mb-2"><label class="form-label small text-muted">Mã ĐVT *</label><input name="codeUser" value="@Model.CodeUser" class="form-control" required /></div>
            <div class="mb-2"><label class="form-label small text-muted">Tên *</label><input name="name" value="@Model.Name" class="form-control" required /></div>
            <div class="mb-2"><label class="form-label small text-muted">Ghi chú</label><input name="remark" value="@Model.Remark" class="form-control" /></div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="active" value="true" id="active" @(Model.Active ? "checked" : "") />
                <label class="form-check-label" for="active">Đang dùng</label>
            </div>
            <button class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu</button>
            <a class="btn btn-outline-secondary" href="/Unit">Hủy</a>
        </form>
    </div></div></div>
</div>